from sklearn.datasets import make_classification
from sklearn.linear_model import Perceptron
import matplotlib.pyplot as plt
import numpy as np

# Set number of samples
n_samples = 1000  # or 10000

# Generate more interesting / complex classification data
X, y = make_classification(n_samples=n_samples,
                           n_features=2,
                           n_informative=2,
                           n_redundant=0,
                           n_clusters_per_class=2,
                           class_sep=1.5,
                           flip_y=0.05,  # add slight label noise
                           random_state=None)  # different every time

# Train Perceptron
clf = Perceptron(fit_intercept=True, max_iter=1000, tol=1e-3)
clf.fit(X, y)

# Output model parameters
print(f"Weights: {clf.coef_}")
print(f"Intercept: {clf.intercept_}")

# Plotting function
def plot_decision_boundary(X, y, clf):
    plt.figure(figsize=(8, 6))
    plt.scatter(X[:, 0], X[:, 1], c=y, cmap='coolwarm', edgecolors='k', alpha=0.8)

    # Create decision boundary
    x_min, x_max = X[:, 0].min(), X[:, 0].max()
    y_min, y_max = X[:, 1].min(), X[:, 1].max()
    xx, yy = np.meshgrid(np.linspace(x_min, x_max, 500),
                         np.linspace(y_min, y_max, 500))
    
    Z = clf.predict(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)
    plt.contourf(xx, yy, Z, alpha=0.2, cmap='coolwarm')

    plt.title(f"Perceptron with Intercept (n={n_samples})")
    plt.xlabel("Feature 1")
    plt.ylabel("Feature 2")
    plt.grid(True)
    plt.show()

plot_decision_boundary(X, y, clf)